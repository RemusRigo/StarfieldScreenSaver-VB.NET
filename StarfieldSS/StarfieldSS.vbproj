<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
   <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
   <ApplicationIcon>Res\Star.ico</ApplicationIcon> 
   <ApplicationManifest>app.manifest</ApplicationManifest>
   <AssemblyName>StarfieldSS</AssemblyName>
   <MyType>WindowsFormsWithCustomSubMain</MyType>
   <OutputType>WinExe</OutputType>
   <Platforms>x64;x86</Platforms>
   <RootNamespace>StarfieldSS</RootNamespace>
   <StartupObject>StarfieldSS.MainProgram</StartupObject>
   <UseWindowsForms>true</UseWindowsForms>
   <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
</PropertyGroup>

<PropertyGroup Condition="'$(TargetFramework)' != ''">
   <TfmName>$(TargetFramework.Replace('-windows', ''))</TfmName>
   <OutputPath>..\bin\$(Configuration)\$(TfmName) $(Platform)\</OutputPath>
   <IntermediateOutputPath>obj\$(Configuration)\$(TfmName) $(Platform)\</IntermediateOutputPath>
</PropertyGroup>

<PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(Platform)' == 'x64'">
   <PlatformTarget>$(Platform)</PlatformTarget>
</PropertyGroup>

<ItemGroup>
   <EmbeddedResource Include="Res\PayPal.png" LogicalName="PayPal.png" />
   <EmbeddedResource Include="Res\Revolut.png" LogicalName="Revolut.png" />
</ItemGroup>

<ItemGroup>
   <Import Include="System.Data" />
   <Import Include="System.Drawing" />
   <Import Include="System.Windows.Forms" />
</ItemGroup>

<Target Name="RenameToScr" AfterTargets="Build">
   <Move Condition="Exists('$(TargetDir)$(AssemblyName).exe')" SourceFiles="$(TargetDir)$(AssemblyName).exe" DestinationFiles="$(TargetDir)$(AssemblyName).scr" />
   <Move Condition="Exists('$(TargetDir)$(AssemblyName).exe.config')" SourceFiles="$(TargetDir)$(AssemblyName).exe.config" DestinationFiles="$(TargetDir)$(AssemblyName).scr.config" />
</Target>

</Project>